{
  "name": "chronicle-66",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/icons/generate-site-icons.mjs && npm run index:popular && next dev",
    "build": "node scripts/icons/generate-site-icons.mjs && npm run validate && npm run index:popular && npm run gallery:optimize && npm run covers:optimize && next build",
    "index:popular": "tsx scripts/popular-index-build.ts",
    "start": "next start",
    "lint": "eslint .",
    "validate": "tsx scripts/validate.ts",
    "archive:edit": "tsx scripts/archive-edit.ts",
    "archive:test": "tsx scripts/test-archive-edit.ts",
    "gallery:optimize": "tsx scripts/gallery-images-optimize.ts",
    "test:vote-search": "tsx scripts/test-vote-search.ts",
    "test:game-list-filter": "tsx scripts/test-game-list-filter.ts",
    "test:game-time": "node --import tsx scripts/test-game-time.ts",
    "test:archive-query": "node --import tsx scripts/test-archive-query.ts",
    "test:archive-loader": "node --import tsx scripts/test-archive-loader.ts",
    "test:archive-payload": "tsx scripts/test-archive-payload.ts",
    "test:analytics": "tsx scripts/test-site-analytics.ts",
    "test:site-texts": "tsx scripts/test-site-texts.ts",
    "test:collection-log": "node --import tsx scripts/test-collection-log.ts",
    "test:update-notice": "node --import tsx scripts/test-update-notice.ts",
    "test:audit-candidates": "node --import tsx scripts/test-title-game-candidates.ts",
    "test:route-prefetch": "node --import tsx scripts/test-route-prefetch.ts",
    "test:live-content": "node --import tsx scripts/test-live-content-loader.ts",
    "test:covers": "node --import tsx scripts/test-responsive-cover.tsx && python3 scripts/test-cover-resource-audit.py",
    "audit:covers": "python3 scripts/audit-cover-resources.py",
    "covers:optimize": "tsx scripts/entry-covers-optimize.ts",
    "test:game-chapters": "node --import tsx scripts/test-game-chapters.ts && node --import tsx scripts/test-game-timeline-gaps.ts",
    "test:game-timeline-gaps": "node --import tsx scripts/test-game-timeline-gaps.ts",
    "dev:timelines": "node scripts/icons/generate-site-icons.mjs && NODE_ENV=development ARCHIVE_TIMELINE_PREVIEW=.local/game-timelines-preview.json CONTENT_BAKE_ORIGIN=off NODE_OPTIONS=--max-old-space-size=768 next dev --hostname 127.0.0.1 --port 3012",
    "test:site-icons": "node scripts/test-site-icons.mjs"
  },
  "dependencies": {
    "next": "^15.5.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "web-vitals": "^6.2.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.18.0",
    "eslint-config-next": "^16.3.0",
    "js-yaml": "^4.1.0",
    "postcss": "^8.5.1",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
